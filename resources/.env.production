# Valeurs figées dans le bundle au build (Vite les inline, il n'y a pas de
# "runtime" pour du JS statique) — remplacées par de vraies valeurs par
# .docker/replace-runtime-env.sh au démarrage du conteneur, à partir des
# vraies variables d'environnement du déploiement. Voir ce script pour la
# liste exacte des jetons.
#
# Ça évite de dépendre du support des "build args" par la plateforme de
# déploiement (peu fiable/mal documenté sur certaines) : une seule variable
# d'environnement classique à régler, au runtime, comme pour le reste du backend.

VITE_APP_NAME=__RUNTIME_VITE_APP_NAME__
VITE_API_BASE_URL=__RUNTIME_VITE_API_BASE_URL__
VITE_ALLOWED_HOST=__RUNTIME_VITE_ALLOWED_HOST__
VITE_REVERB_APP_KEY=__RUNTIME_VITE_REVERB_APP_KEY__
VITE_REVERB_HOST=__RUNTIME_VITE_REVERB_HOST__
VITE_REVERB_PORT=__RUNTIME_VITE_REVERB_PORT__
VITE_REVERB_SCHEME=__RUNTIME_VITE_REVERB_SCHEME__
